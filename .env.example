# ── Auth (next-auth v5) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me
# Only needed when the app can't infer its own URL (e.g. behind some proxies).
# AUTH_URL=https://your-domain.example

# ── MongoDB Atlas ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/manabi?retryWrites=true&w=majority

# ── Groq (server-only — never prefix with NEXT_PUBLIC_) ───────────────
# Leave empty in local development to use the built-in sample questions.
GROQ_API_KEY=
# Optional: models to rotate across (default in lib/ai/models.ts).
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# ── Upstash Redis (rate limits). If unset, rate limiting is disabled. ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
